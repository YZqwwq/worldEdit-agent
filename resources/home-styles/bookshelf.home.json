{
  "id": "bookshelf",
  "name": "世界观书架",
  "version": "1.0.0",
  "apiVersion": 1,
  "html": "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><style>\n*{box-sizing:border-box}body{margin:0;background:#f7f9f8;color:#1d2823;font:14px system-ui}main{max-width:840px;margin:64px auto;padding:24px}h1{font-size:28px}nav{display:flex;gap:12px;margin:24px 0}button{font:inherit;border:1px solid #cbd8d1;border-radius:4px;padding:10px 14px;background:white;color:inherit;cursor:pointer}li{display:flex;gap:8px;border-bottom:1px solid #dce4df;padding:14px 0}ul{padding:0;list-style:none}.world{flex:1;text-align:left;min-width:0;overflow-wrap:anywhere}.status{color:#607368}@media(max-width:500px){main{margin:20px auto}li{flex-wrap:wrap}.world{flex-basis:100%}}\n</style></head><body><main><h1>世界观书架</h1><nav><button id=\"create\">创建世界观</button><button id=\"assistant\">AI 助手</button><button id=\"reload\">刷新</button></nav><p class=\"status\" id=\"status\"></p><ul id=\"worlds\"></ul></main><script>\nconst action=(action,worldId)=>parent.postMessage({type:'worldedit:home-action',action,worldId},'*');\nfor(const id of ['create','assistant','reload'])document.getElementById(id).onclick=()=>action(id);\nwindow.addEventListener('message',event=>{\n if(event.source!==parent||event.data?.type!=='worldedit:home-state')return;\n const state=event.data;\n document.getElementById('status').textContent=state.error||(state.loading?'正在读取…':state.worlds.length+' 个世界观');\n const list=document.getElementById('worlds');list.replaceChildren();\n for(const world of state.worlds){const row=document.createElement('li');for(const [command,label] of [['open',world.name],['edit','编辑'],['delete','删除']]){const button=document.createElement('button');button.textContent=label;if(command==='open')button.className='world';button.onclick=()=>action(command,world.id);row.append(button)}list.append(row)}\n});\nparent.postMessage({type:'worldedit:home-ready'},'*');\n</script></body></html>"
}
